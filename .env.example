# Updater signing for `npm run tauri build` / `npm run tauri:release` (Tauri auto-update).
#
# Copy this file to `.env` (which is gitignored) and point it at YOUR private key.
# The matching PUBLIC key is committed in src-tauri/tauri.conf.json; the PRIVATE
# key is never committed — it lives outside the repo (e.g. ~/.pcbreview/updater.key).
# Set this up once per machine; after that any `npm run tauri ...` loads these (the
# `tauri` npm script is wrapped with `dotenv -e .env`), so the build signs
# automatically. No `.env`? dotenv-cli no-ops, so unsigned dev builds still work.

# Absolute PATH to the minisign private key file — NOT its base64 contents.
# (Putting the contents in TAURI_SIGNING_PRIVATE_KEY is what caused
#  "failed to decode base64 secret key: Invalid symbol 34, offset 0" — symbol 34 is a
#  stray double-quote that wrapping/quoting added. A path can't have that problem.)
TAURI_SIGNING_PRIVATE_KEY_PATH=C:\Users\you\.pcbreview\updater.key

# Key password. Ours is passwordless, so leave this EMPTY (just `=`) so the build
# doesn't stop to prompt. dotenv-cli passes the empty value through correctly
# (PowerShell / setx / .NET all turn an empty string into a *deleted* variable).
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Sentry DSN for anonymized telemetry (crashes, active-user sessions, usage
# summaries, log errors). Baked into the binary at COMPILE time via option_env!
# in src-tauri/src/telemetry.rs — so release builds made with `npm run
# tauri:release` ship it, while a build without it stays completely silent
# (nothing is ever sent). The DSN is a public write-only key; it still lives
# here rather than in the repo so forks don't spam your project.
# Get it from: sentry.io → your project → Settings → Client Keys (DSN).
PCBREVIEW_SENTRY_DSN=
