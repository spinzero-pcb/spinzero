{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpinZero",
  "identifier": "spinzero",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SpinZero",
        "width": 1440,
        "height": 920,
        "minWidth": 1000,
        "minHeight": 650,
        "theme": "Dark",
        "decorations": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disk-cache-size=1048576000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/spinzero-pcb/spinzero/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhDOUNEMkI4M0M1RERDMjAKUldRZzNGMDh1TktjakR0V042TGtEd1dxaWEyR1BPZWxIbDRBWlZHZkpGVzVPT1l2MnBaQU02WEoK"
    }
  }
}
